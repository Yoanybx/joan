{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/authority-envelope.v0.schema.json",
  "title": "JOAN Authority Envelope v0",
  "type": "object",
  "required": ["schema", "host_identity", "task_id", "path", "task_kind", "roots", "approval_required", "approvable", "approvals"],
  "properties": {
    "schema": {"const": "joan.authority-envelope.v0"},
    "host_identity": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "path": {"type": "string"},
    "task_kind": {"type": "string", "minLength": 1},
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["root_id", "grants", "denies"],
        "properties": {
          "root_id": {"type": "string", "minLength": 1},
          "grants": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "denies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "approval_required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "approvable": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nonce", "task_id", "capabilities"],
        "properties": {
          "nonce": {"type": "string", "minLength": 1},
          "task_id": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
