{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/evidence-index.v2.schema.json",
  "title": "JOAN Evidence Index v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "generated_at",
    "source",
    "inventory",
    "conformance",
    "supply_chain",
    "verification",
    "benchmark",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "joan.evidence-index.v2"},
    "version": {"const": "0.1.0-alpha.1"},
    "status": {
      "enum": ["pending-local-verification", "local-verification-passed-with-receipts"]
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "inventory": {"$ref": "#/$defs/inventory"},
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jce1", "jdr1"],
      "properties": {
        "jce1": {"$ref": "#/$defs/jce1"},
        "jdr1": {"$ref": "#/$defs/jdr1"}
      }
    },
    "supply_chain": {"$ref": "#/$defs/supplyChain"},
    "verification": {"$ref": "#/$defs/verification"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "required_gate_ids": {"maxItems": 10}
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "runs": {
                "items": {
                  "properties": {"gate_count": {"const": 10}}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "required_gate_ids": {"minItems": 11}
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "runs": {
                "items": {
                  "properties": {"gate_count": {"const": 11}}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "local-verification-passed-with-receipts"}}},
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "runs": {
                "minItems": 3,
                "maxItems": 3,
                "prefixItems": [
                  {"properties": {"ordinal": {"const": 1}}},
                  {"properties": {"ordinal": {"const": 2}}},
                  {"properties": {"ordinal": {"const": 3}}}
                ],
                "items": false
              },
              "repeatability": {
                "properties": {
                  "required_runs": {"const": 3},
                  "completed_runs": {"const": 3},
                  "unique_run_ids": {"const": 3},
                  "same_source": {"const": true},
                  "same_observations": {"const": true}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_digest", "file_count", "excludes"],
      "properties": {
        "tree_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "profile", "value"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "profile": {"const": "joan-source-tree-v2"},
            "value": {"$ref": "#/$defs/sha256"}
          }
        },
        "file_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "excludes": {"const": [".git", "target", ".joan/evidence", "**/.DS_Store", "**/._*"]}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_crates", "json_schemas", "rust_tests"],
      "properties": {
        "workspace_crates": {"type": "integer", "minimum": 1},
        "json_schemas": {"type": "integer", "minimum": 1},
        "rust_tests": {"type": "integer", "minimum": 1}
      }
    },
    "jce1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "total", "passed", "suite_digest", "specification", "implementations"],
      "properties": {
        "status": {"enum": ["pending", "passed-local-cross-implementation"]},
        "total": {"const": 27},
        "passed": {"type": "integer", "minimum": 0, "maximum": 27},
        "suite_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "profile", "domain", "value"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "profile": {"const": "joan-hash-v1"},
            "domain": {"const": "joan.conformance-vector.v1"},
            "value": {"$ref": "#/$defs/sha256"}
          }
        },
        "specification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "declared_sha256", "binding"],
          "properties": {
            "path": {"const": "spec/canonical-profile-jce1.md"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "declared_sha256": {"$ref": "#/$defs/sha256"},
            "binding": {"enum": ["pending", "matched"]}
          }
        },
        "implementations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "jdr1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cases", "seed", "test_path", "test_file_sha256"],
      "properties": {
        "status": {"enum": ["pending", "current-source-test-bound"]},
        "cases": {"const": 10000},
        "seed": {"const": 144},
        "test_path": {"const": "crates/joan-sim/tests/corpus.rs"},
        "test_file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "run_id", "path", "file_sha256", "status", "started_at", "completed_at", "source_digest", "gate_count"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 3},
        "run_id": {"type": "string", "format": "uuid"},
        "path": {"type": "string", "pattern": "^\\.joan/evidence/runs/.+\\.json$"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "passed"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "gate_count": {"enum": [10, 11]}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "gate_config", "required_gate_ids", "runs", "repeatability"],
      "properties": {
        "runner": {"$ref": "#/$defs/fileBinding"},
        "gate_config": {"$ref": "#/$defs/fileBinding"},
        "required_gate_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "oneOf": [
            {
              "prefixItems": [
                {"const": "format"},
                {"const": "clippy"},
                {"const": "tests"},
                {"const": "doc-tests"},
                {"const": "release-build"},
                {"const": "jce1"},
                {"const": "c-digest-smoke"},
                {"const": "payment-cost-vector"},
                {"const": "cargo-deny"},
                {"const": "cargo-audit"}
              ],
              "items": false
            },
            {
              "prefixItems": [
                {"const": "format"},
                {"const": "clippy"},
                {"const": "tests"},
                {"const": "doc-tests"},
                {"const": "release-build"},
                {"const": "jce1"},
                {"const": "c-digest-smoke"},
                {"const": "payment-cost-vector"},
                {"const": "tool-forge"},
                {"const": "cargo-deny"},
                {"const": "cargo-audit"}
              ],
              "items": false
            }
          ]
        },
        "runs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/run"}
        },
        "repeatability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_runs", "completed_runs", "unique_run_ids", "same_source", "same_observations"],
          "properties": {
            "required_runs": {"const": 3},
            "completed_runs": {"type": "integer", "minimum": 0, "maximum": 3},
            "unique_run_ids": {"type": "integer", "minimum": 0, "maximum": 3},
            "same_source": {"type": "boolean"},
            "same_observations": {"type": "boolean"}
          }
        }
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_audit", "cargo_deny"],
      "properties": {
        "cargo_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "advisory_database_commit", "dependency_count", "vulnerabilities_found"],
          "properties": {
            "status": {"const": "passed"},
            "tool_version": {"type": "string", "minLength": 1},
            "advisory_database_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dependency_count": {"type": "integer", "minimum": 0},
            "vulnerabilities_found": {"const": 0}
          }
        },
        "cargo_deny": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "checks"],
          "properties": {
            "status": {"const": "passed"},
            "tool_version": {"type": "string", "minLength": 1},
            "checks": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {"enum": ["advisories", "bans", "licenses", "sources"]}
            }
          }
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "status", "faster_observed", "language_superiority_claim", "agent_scorecard", "native_backend", "payment_cost"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "equivalent-output"},
        "faster_observed": {"type": "string", "minLength": 1},
        "language_superiority_claim": {"const": false},
        "agent_scorecard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256",
            "status",
            "workload_count",
            "joan_safety_cases_protected",
            "joan_safety_cases_total",
            "broad_language_superiority_claim",
            "universal_language_superiority_claim"
          ],
          "properties": {
            "path": {"const": "benchmarks/results/2026-08-12-mac15-4-agent-scorecard.json"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "status": {"const": "baseline-only-not-qualified"},
            "workload_count": {"const": 2},
            "joan_safety_cases_protected": {"const": 4},
            "joan_safety_cases_total": {"const": 4},
            "broad_language_superiority_claim": {"const": false},
            "universal_language_superiority_claim": {"const": false}
          }
        },
        "native_backend": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file_sha256",
            "status",
            "mode",
            "measured_source_tree_sha256",
            "workload_count",
            "samples_per_workload",
            "rss_samples_per_implementation",
            "iterations_per_sample",
            "oracle_verified_cases",
            "output_equivalent",
            "independent_rerun",
            "julia_measured",
            "universal_language_superiority_claim"
          ],
          "properties": {
            "path": {"const": "benchmarks/results/2026-08-13-mac15-4-native-backend.json"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "status": {"const": "local-benchmark-not-qualified"},
            "mode": {"const": "recorded"},
            "measured_source_tree_sha256": {"$ref": "#/$defs/sha256"},
            "workload_count": {"const": 5},
            "samples_per_workload": {"const": 101},
            "rss_samples_per_implementation": {"const": 11},
            "iterations_per_sample": {"const": 1000000},
            "oracle_verified_cases": {"const": 15},
            "output_equivalent": {"const": true},
            "independent_rerun": {"const": false},
            "julia_measured": {"const": false},
            "universal_language_superiority_claim": {"const": false}
          }
        },
        "payment_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "status", "selected_candidate_id", "universal_cheapest_claim"],
          "properties": {
            "path": {"const": "vectors/payment-cost/report-v0.json"},
            "file_sha256": {"$ref": "#/$defs/sha256"},
            "status": {"enum": ["illustrative-local-only", "scenario-local-qualified-quotes-only"]},
            "selected_candidate_id": {"type": "string", "minLength": 1},
            "universal_cheapest_claim": {"const": false}
          }
        }
      }
    }
  }
}
