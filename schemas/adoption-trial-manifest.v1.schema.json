{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/adoption-trial-manifest.v1.schema.json",
  "title": "JOAN GitHub-only Adoption Trial Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "profile", "source", "task", "execution", "safety", "qualification", "scope"],
  "properties": {
    "schema": {"const": "joan.adoption-trial-manifest.v1"},
    "version": {"const": "0.1.0-alpha.1"},
    "profile": {"const": "github-only-repository-inspection-v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_repository", "git_remote", "clean_checkout_required", "tagged_release_required"],
      "properties": {
        "official_repository": {"const": "https://github.com/Yoanybx/joan"},
        "git_remote": {"const": "https://github.com/Yoanybx/joan.git"},
        "clean_checkout_required": {"const": true},
        "tagged_release_required": {"const": false}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "fixture", "fixture_sha256", "repetitions", "oracle", "baseline", "joan"],
      "properties": {
        "id": {"const": "repository-inspection-basic-v1"},
        "class": {"const": "repository-audit"},
        "fixture": {"const": "examples/inspect-fixtures/basic"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "repetitions": {"type": "integer", "minimum": 3, "maximum": 21},
        "oracle": {"$ref": "#/$defs/observation"},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "command"],
          "properties": {
            "implementation": {"const": "node-reference-no-shared-rust"},
            "command": {
              "const": ["node", "reference/adoption-trial-baseline.mjs", "examples/inspect-fixtures/basic"]
            }
          }
        },
        "joan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "command"],
          "properties": {
            "implementation": {"const": "joan-repository-inspector"},
            "command": {
              "const": ["<joan-binary>", "repo", "inspect", "examples/inspect-fixtures/basic", "--json"]
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "required_tools", "pinned_versions", "supported_hosts"],
      "properties": {
        "command": {"const": ["bash", "scripts/run-adoption-trial.sh", "<absolute-output-directory>", "<operator-relation>"]},
        "required_tools": {
          "const": ["bash", "cargo", "git", "node", "rustc"]
        },
        "pinned_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "rustc_prefix"],
          "properties": {
            "node": {"const": "v24.19.0"},
            "rustc_prefix": {"const": "rustc 1.94.1 "}
          }
        },
        "supported_hosts": {"const": ["darwin", "linux"]}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_acquisition", "task_network", "telemetry", "secrets", "account", "wallet", "payments", "repository_writes", "generated_output"],
      "properties": {
        "source_acquisition": {"const": "official-github-repository"},
        "task_network": {"const": "none"},
        "telemetry": {"const": "none"},
        "secrets": {"const": "not-required"},
        "account": {"const": "not-required-for-local-trial"},
        "wallet": {"const": "not-required"},
        "payments": {"const": "none"},
        "repository_writes": {"const": "forbidden"},
        "generated_output": {"const": "absolute-path-outside-checkout"}
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_trials_required", "successful_trials_required", "repeat_or_recommend_required", "self_execution_counts", "machine_provenance_is_independence", "universal_claim_allowed"],
      "properties": {
        "external_trials_required": {"const": 3},
        "successful_trials_required": {"const": 3},
        "repeat_or_recommend_required": {"const": 2},
        "self_execution_counts": {"const": false},
        "machine_provenance_is_independence": {"const": false},
        "universal_claim_allowed": {"const": false}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_paths", "excluded_effects"],
      "properties": {
        "review_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
        },
        "excluded_effects": {
          "const": ["deployment", "listener", "payment", "release", "secret-access", "telemetry"]
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instructionFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 131072}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "mode", "network", "telemetry", "writes", "manifests", "languages", "instruction_files", "diagnostic_codes"],
      "properties": {
        "schema": {"const": "joan.adoption-trial-observation.v1"},
        "mode": {"const": "read-only-offline"},
        "network": {"const": "denied-by-design-no-network-client"},
        "telemetry": {"const": "none"},
        "writes": {"const": "none"},
        "manifests": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "instruction_files": {
          "type": "array",
          "items": {"$ref": "#/$defs/instructionFile"}
        },
        "diagnostic_codes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
