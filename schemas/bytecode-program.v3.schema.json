{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/bytecode-program.v3.schema.json",
  "title": "JOAN Verified Bytecode Program v3 Information Flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "semantic_digest", "semantic_identity", "canonical_ast", "entry_function", "functions"],
  "properties": {
    "schema": {"const": "joan.bytecode-program.v3"},
    "module": {"$ref": "#/$defs/identifier"},
    "semantic_digest": {"$ref": "#/$defs/semanticDigest"},
    "semantic_identity": {"$ref": "canonical-ast-identity.v2.schema.json"},
    "canonical_ast": {"$ref": "canonical-ast.v2.schema.json"},
    "entry_function": {"type": "integer", "minimum": 0, "maximum": 1023},
    "functions": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"$ref": "#/$defs/function"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "type": {"enum": ["i64", "bool", "string", "unit"]},
    "nonUnitType": {"enum": ["i64", "bool", "string"]},
    "semanticDigest": {
      "allOf": [
        {"$ref": "digest.v1.schema.json"},
        {"type": "object", "properties": {"domain": {"const": "joan.language-canonical-ast.v3"}}}
      ]
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "effect"],
      "properties": {"name": {"$ref": "#/$defs/identifier"}, "effect": {"$ref": "#/$defs/identifier"}}
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameter_count", "parameter_types", "parameter_information", "local_count", "local_types", "local_information", "return_type", "return_information", "effects", "authority_slots", "instructions"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "parameter_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "parameter_types": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/nonUnitType"}},
        "parameter_information": {"type": "array", "maxItems": 64, "items": {"$ref": "information-label.v1.schema.json"}},
        "local_count": {"type": "integer", "minimum": 0, "maximum": 100064},
        "local_types": {"type": "array", "maxItems": 100064, "items": {"$ref": "#/$defs/nonUnitType"}},
        "local_information": {"type": "array", "maxItems": 100064, "items": {"$ref": "information-label.v1.schema.json"}},
        "return_type": {"$ref": "#/$defs/type"},
        "return_information": {"$ref": "information-label.v1.schema.json"},
        "effects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "authority_slots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/authority"}},
        "instructions": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/instruction"}}
      }
    },
    "value": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "i64"}, "value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "string"}, "value": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "unit"}}}
      ]
    },
    "instruction": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": {"op": {"const": "push"}, "value": {"$ref": "#/$defs/value"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "slot"], "properties": {"op": {"enum": ["load-local", "store-local"]}, "slot": {"type": "integer", "minimum": 0, "maximum": 100063}}},
        {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"enum": ["pop", "negate", "not", "add", "subtract", "multiply", "divide", "remainder", "equal", "not-equal", "less", "less-equal", "greater", "greater-equal", "and", "or", "return"]}}},
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "function", "argument_count"],
          "properties": {"op": {"const": "call"}, "function": {"type": "integer", "minimum": 0, "maximum": 1023}, "argument_count": {"type": "integer", "minimum": 0, "maximum": 64}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["op", "effect", "authority", "information", "argument_count"],
          "properties": {"op": {"const": "request"}, "effect": {"$ref": "#/$defs/identifier"}, "authority": {"$ref": "#/$defs/identifier"}, "information": {"$ref": "information-label.v1.schema.json"}, "argument_count": {"type": "integer", "minimum": 0, "maximum": 200000}}
        }
      ]
    }
  }
}
