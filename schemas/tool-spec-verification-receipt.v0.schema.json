{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/tool-spec-verification-receipt.v0.schema.json",
  "title": "JOAN ToolSpec Verification Receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec_digest", "status", "findings", "receipt_digest"],
  "properties": {
    "schema": {"const": "joan.tool-spec-verification-receipt.v0"},
    "spec_digest": {"$ref": "#/$defs/specDigest"},
    "status": {"enum": ["verified", "rejected"]},
    "findings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/finding"}},
    "receipt_digest": {"$ref": "#/$defs/receiptDigest"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"findings": {"maxItems": 0}}}},
    {"if": {"properties": {"status": {"const": "rejected"}}}, "then": {"properties": {"findings": {"minItems": 1}}}}
  ],
  "$defs": {
    "specDigest": {"allOf": [{"$ref": "digest.v1.schema.json"}, {"properties": {"domain": {"const": "joan.tool-spec.v1"}}}]},
    "receiptDigest": {"allOf": [{"$ref": "digest.v1.schema.json"}, {"properties": {"domain": {"const": "joan.tool-spec-verification.v1"}}}]},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "pattern": "^TF[0-9]{4}$"}, "message": {"type": "string", "minLength": 1, "maxLength": 256}}}
  }
}
