{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/agent-scorecard-report.v1.schema.json",
  "title": "JOAN Agent Scorecard Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_scope",
    "generated_at",
    "manifest_sha256",
    "mode",
    "platform",
    "preparation_sample_count",
    "qualification",
    "safety",
    "sample_count",
    "schema",
    "toolchains",
    "universal_language_superiority_claim",
    "workloads"
  ],
  "properties": {
    "claim_scope": {"const": "ai-agent-task-path-baseline-only"},
    "generated_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "mode": {"enum": ["smoke", "recorded"]},
    "platform": {"$ref": "#/$defs/platform"},
    "preparation_sample_count": {"type": "integer", "minimum": 1, "maximum": 21},
    "qualification": {"$ref": "#/$defs/qualification"},
    "safety": {"$ref": "#/$defs/safety"},
    "sample_count": {"type": "integer", "minimum": 3, "maximum": 101},
    "schema": {"const": "joan.agent-scorecard-report.v1"},
    "toolchains": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/toolchain"}
    },
    "universal_language_superiority_claim": {"const": false},
    "workloads": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/workload"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonNegativeInteger": {"type": "integer", "minimum": 0},
    "nullableNonNegativeInteger": {"type": ["integer", "null"], "minimum": 0},
    "implementation": {"enum": ["joan", "c", "rust", "typescript"]},
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_ns", "min_ns", "p50_ns", "p95_ns", "p99_ns", "samples_ns"],
      "properties": {
        "max_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "min_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "p50_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "p95_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "p99_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "samples_ns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 101,
          "items": {"$ref": "#/$defs/nonNegativeInteger"}
        }
      }
    },
    "implementationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_stdout_bytes",
        "artifact_bytes",
        "artifact_scope",
        "implementation",
        "normalized_output_bytes",
        "output_sha256",
        "peak_rss_bytes",
        "preparation",
        "runtime",
        "source_bytes",
        "source_sha256"
      ],
      "properties": {
        "actual_stdout_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "artifact_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "artifact_scope": {
          "enum": [
            "serialized-bytecode-and-verification-receipt",
            "native-executable",
            "typescript-source-native-strip-runtime"
          ]
        },
        "implementation": {"$ref": "#/$defs/implementation"},
        "normalized_output_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "output_sha256": {"$ref": "#/$defs/sha256"},
        "peak_rss_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"},
        "preparation": {"$ref": "#/$defs/timings"},
        "runtime": {"$ref": "#/$defs/timings"},
        "source_bytes": {"$ref": "#/$defs/nonNegativeInteger"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best_native_p95_ns",
        "best_native_peak_rss_bytes",
        "joan_p95_ns",
        "joan_peak_rss_bytes",
        "joan_to_best_native_peak_rss_ratio_ppm",
        "joan_to_best_native_runtime_ratio_ppm"
      ],
      "properties": {
        "best_native_p95_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "best_native_peak_rss_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"},
        "joan_p95_ns": {"$ref": "#/$defs/nonNegativeInteger"},
        "joan_peak_rss_bytes": {"$ref": "#/$defs/nullableNonNegativeInteger"},
        "joan_to_best_native_peak_rss_ratio_ppm": {"$ref": "#/$defs/nullableNonNegativeInteger"},
        "joan_to_best_native_runtime_ratio_ppm": {"$ref": "#/$defs/nonNegativeInteger"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comparison", "equivalence_passed", "expected_output_sha256", "id", "results"],
      "properties": {
        "comparison": {"$ref": "#/$defs/comparison"},
        "equivalence_passed": {"const": true},
        "expected_output_sha256": {"$ref": "#/$defs/sha256"},
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "results": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/implementationResult"}
        }
      }
    },
    "safetyObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_evidence_sha256",
        "expected_status_match",
        "implementation",
        "protects",
        "stage",
        "status"
      ],
      "properties": {
        "diagnostic_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "expected_status_match": {"const": true},
        "implementation": {"$ref": "#/$defs/implementation"},
        "protects": {"type": "boolean"},
        "stage": {"enum": ["check", "compile", "run", "strip-check"]},
        "status": {"enum": ["accepted", "rejected"]}
      }
    },
    "safetyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observations", "rule"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "observations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/safetyObservation"}
        },
        "rule": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "protectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected", "protection_ppm", "total"],
      "properties": {
        "protected": {"$ref": "#/$defs/nonNegativeInteger"},
        "protection_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joan", "c", "rust", "typescript"],
      "properties": {
        "joan": {"$ref": "#/$defs/protectionSummary"},
        "c": {"$ref": "#/$defs/protectionSummary"},
        "rust": {"$ref": "#/$defs/protectionSummary"},
        "typescript": {"$ref": "#/$defs/protectionSummary"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "protection", "results"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 4, "maximum": 64},
        "protection": {"$ref": "#/$defs/protection"},
        "results": {
          "type": "array",
          "minItems": 4,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/safetyResult"}
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockers",
        "broad_language_superiority_claim",
        "correctness_equivalent",
        "eligible",
        "independent_rerun",
        "joan_safety_cases_protected",
        "joan_safety_cases_total",
        "material_wins",
        "native_backend",
        "peak_rss_targets_met",
        "runtime_targets_met",
        "status"
      ],
      "properties": {
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "broad_language_superiority_claim": {"const": false},
        "correctness_equivalent": {"const": true},
        "eligible": {"const": false},
        "independent_rerun": {"const": false},
        "joan_safety_cases_protected": {"type": "integer", "minimum": 0},
        "joan_safety_cases_total": {"type": "integer", "minimum": 1},
        "material_wins": {"$ref": "#/$defs/nonNegativeInteger"},
        "native_backend": {"const": false},
        "peak_rss_targets_met": {"type": "boolean"},
        "runtime_targets_met": {"type": "boolean"},
        "status": {"const": "baseline-only-not-qualified"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "model", "os", "processor", "release"],
      "properties": {
        "arch": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "processor": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "executable_sha256", "id", "version"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "id": {"enum": ["joan", "c", "rust", "typescript-runtime"]},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
