{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/verification-run-receipt.v1.schema.json",
  "title": "JOAN Verification Run Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "run_id",
    "status",
    "started_at",
    "completed_at",
    "source",
    "environment",
    "gates",
    "summary",
    "observations",
    "supply_chain"
  ],
  "properties": {
    "schema": {"const": "joan.verification-run-receipt.v1"},
    "version": {"const": "0.1.0-alpha.1"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["passed", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "os_release", "tools", "runner_sha256"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "os_release": {"type": "string", "minLength": 1},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "gate_config_sha256": {"$ref": "#/$defs/sha256"},
        "tools": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/tool"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/gate"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "executed", "passed", "failed"],
      "properties": {
        "required": {"enum": [10, 11]},
        "executed": {"type": "integer", "minimum": 1, "maximum": 11},
        "passed": {"type": "integer", "minimum": 0, "maximum": 11},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "observations": {"type": "object"},
    "supply_chain": {"$ref": "#/$defs/supplyChain"}
  },
  "allOf": [
    {
      "if": {"properties": {"summary": {"properties": {"required": {"const": 10}}}}},
      "then": {
        "properties": {
          "gates": {
            "maxItems": 10,
            "prefixItems": [
              {"properties": {"id": {"const": "format"}}},
              {"properties": {"id": {"const": "clippy"}}},
              {"properties": {"id": {"const": "tests"}}},
              {"properties": {"id": {"const": "doc-tests"}}},
              {"properties": {"id": {"const": "release-build"}}},
              {"properties": {"id": {"const": "jce1"}}},
              {"properties": {"id": {"const": "c-digest-smoke"}}},
              {"properties": {"id": {"const": "payment-cost-vector"}}},
              {"properties": {"id": {"const": "cargo-deny"}}},
              {"properties": {"id": {"const": "cargo-audit"}}}
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {"properties": {"summary": {"properties": {"required": {"const": 11}}}}},
      "then": {
        "properties": {
          "environment": {"required": ["gate_config_sha256"]},
          "gates": {
            "maxItems": 11,
            "prefixItems": [
              {"properties": {"id": {"const": "format"}}},
              {"properties": {"id": {"const": "clippy"}}},
              {"properties": {"id": {"const": "tests"}}},
              {"properties": {"id": {"const": "doc-tests"}}},
              {"properties": {"id": {"const": "release-build"}}},
              {"properties": {"id": {"const": "jce1"}}},
              {"properties": {"id": {"const": "c-digest-smoke"}}},
              {"properties": {"id": {"const": "payment-cost-vector"}}},
              {"properties": {"id": {"const": "tool-forge"}}},
              {"properties": {"id": {"const": "cargo-deny"}}},
              {"properties": {"id": {"const": "cargo-audit"}}}
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "passed"},
          "summary": {"properties": {"required": {"const": 10}}}
        }
      },
      "then": {
        "properties": {
          "gates": {"minItems": 10, "maxItems": 10, "$ref": "#/$defs/passedGates"},
          "summary": {
            "properties": {
              "executed": {"const": 10},
              "passed": {"const": 10},
              "failed": {"const": 0}
            }
          },
          "supply_chain": {"$ref": "#/$defs/passedSupplyChain"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "passed"},
          "summary": {"properties": {"required": {"const": 11}}}
        }
      },
      "then": {
        "properties": {
          "gates": {"minItems": 11, "maxItems": 11, "$ref": "#/$defs/passedGates"},
          "summary": {
            "properties": {
              "executed": {"const": 11},
              "passed": {"const": 11},
              "failed": {"const": 0}
            }
          },
          "supply_chain": {"$ref": "#/$defs/passedSupplyChain"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "allOf": [
          {"properties": {"supply_chain": {"$ref": "#/$defs/failedSupplyChain"}}},
          {
            "oneOf": [
              {
                "properties": {
                  "gates": {
                    "minItems": 1,
                    "maxItems": 1,
                    "prefixItems": [
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 1},
                      "passed": {"const": 0},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 2,
                    "maxItems": 2,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 2},
                      "passed": {"const": 1},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 3,
                    "maxItems": 3,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 3},
                      "passed": {"const": 2},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 4,
                    "maxItems": 4,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 4},
                      "passed": {"const": 3},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 5,
                    "maxItems": 5,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 5},
                      "passed": {"const": 4},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 6,
                    "maxItems": 6,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 6},
                      "passed": {"const": 5},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 7,
                    "maxItems": 7,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 7},
                      "passed": {"const": 6},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 8,
                    "maxItems": 8,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 8},
                      "passed": {"const": 7},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 9,
                    "maxItems": 9,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 9},
                      "passed": {"const": 8},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 10,
                    "maxItems": 10,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 10},
                      "passed": {"const": 9},
                      "failed": {"const": 1}
                    }
                  }
                }
              },
              {
                "properties": {
                  "gates": {
                    "minItems": 11,
                    "maxItems": 11,
                    "prefixItems": [
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/passedGateResult"},
                      {"$ref": "#/$defs/failedGateResult"}
                    ],
                    "items": false
                  },
                  "summary": {
                    "properties": {
                      "executed": {"const": 11},
                      "passed": {"const": 10},
                      "failed": {"const": 1}
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_digest", "file_count", "excludes"],
      "properties": {
        "tree_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "profile", "value"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "profile": {"const": "joan-source-tree-v2"},
            "value": {"$ref": "#/$defs/sha256"}
          }
        },
        "file_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "excludes": {"const": [".git", "target", ".joan/evidence", "**/.DS_Store", "**/._*"]}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "executable_path",
        "executable_sha256",
        "started_at",
        "completed_at",
        "duration_ms",
        "status",
        "exit_code",
        "signal",
        "stdout",
        "stderr"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "status": {"enum": ["passed", "failed"]},
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["string", "null"]},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"}
      }
    },
    "passedGates": {
      "items": {
        "properties": {
          "status": {"const": "passed"},
          "exit_code": {"const": 0},
          "signal": {"const": null}
        }
      }
    },
    "passedGateResult": {
      "properties": {
        "status": {"const": "passed"},
        "exit_code": {"const": 0},
        "signal": {"const": null}
      }
    },
    "failedGateResult": {
      "properties": {
        "status": {"const": "failed"}
      }
    },
    "passedSupplyChain": {
      "properties": {
        "cargo_audit": {"properties": {"status": {"const": "passed"}}},
        "cargo_deny": {"properties": {"status": {"const": "passed"}}}
      }
    },
    "failedSupplyChain": {
      "properties": {
        "cargo_audit": {"properties": {"status": {"const": "failed"}}},
        "cargo_deny": {"properties": {"status": {"const": "failed"}}}
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_audit", "cargo_deny"],
      "properties": {
        "cargo_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "advisory_database_commit", "dependency_count", "vulnerabilities_found"],
          "properties": {
            "status": {"enum": ["passed", "failed"]},
            "tool_version": {"type": "string", "minLength": 1},
            "advisory_database_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dependency_count": {"type": "integer", "minimum": 0},
            "vulnerabilities_found": {"const": 0}
          }
        },
        "cargo_deny": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "checks"],
          "properties": {
            "status": {"enum": ["passed", "failed"]},
            "tool_version": {"type": "string", "minLength": 1},
            "checks": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {"enum": ["advisories", "bans", "licenses", "sources"]}
            }
          }
        }
      }
    }
  }
}
