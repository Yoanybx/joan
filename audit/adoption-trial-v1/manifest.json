      "examples/inspect-fixtures/basic",
      "reference/adoption-trial-baseline.mjs",
      "schemas/adoption-trial-manifest.v1.schema.json",
      "schemas/adoption-trial-run-receipt.v1.schema.json",
      "scripts/run-adoption-trial.sh",
      "scripts/verify-adoption-trial.sh",
      "scripts/verify-all.sh",
      "tools/adoption-trial.mjs"
    ],
    "excluded_effects": ["deployment", "listener", "payment", "release", "secret-access", "telemetry"]
  }
}
