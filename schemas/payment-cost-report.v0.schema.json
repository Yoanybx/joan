{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/payment-cost-report.v0.schema.json",
  "title": "JOAN Payment Cost Report v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario_id",
    "input_sha256",
    "unit",
    "metric",
    "claim_scope",
    "universal_cheapest_claim",
    "joan_protocol_fee",
    "selected_candidate_id",
    "ranked_qualified_candidates",
    "excluded_candidates"
  ],
  "properties": {
    "schema": {"const": "joan.payment-cost-report.v0"},
    "scenario_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "unit": {"const": "micro_usd"},
    "metric": {"const": "unsubsidized_total_effective_cost_per_expected_successful_item"},
    "claim_scope": {"enum": ["illustrative-local-only", "scenario-local-qualified-quotes-only"]},
    "universal_cheapest_claim": {"const": false},
    "joan_protocol_fee": {"const": "zero"},
    "selected_candidate_id": {"type": "string", "minLength": 1},
    "ranked_qualified_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/result"}
    },
    "excluded_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "integerString": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_at", "expires_at", "source"],
      "properties": {
        "kind": {"enum": ["declared-fixture", "official-fixed-fee", "measured-live-quote"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mode",
        "qualification",
        "provenance",
        "settlement_item_count",
        "settlement_volume_micro_usd",
        "components",
        "explicit_subsidy_micro_usd",
        "unsubsidized_total_effective_cost_micro_usd",
        "buyer_cost_after_explicit_subsidy_micro_usd",
        "unsubsidized_cost_per_expected_successful_item_micro_usd",
        "buyer_cost_per_expected_successful_item_micro_usd"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "qualification": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"},
        "settlement_item_count": {"$ref": "#/$defs/integerString"},
        "settlement_volume_micro_usd": {"$ref": "#/$defs/integerString"},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "external_fixed_micro_usd",
            "external_variable_micro_usd",
            "fx_slippage_micro_usd",
            "verification_micro_usd",
            "infrastructure_micro_usd",
            "expected_dispute_micro_usd",
            "capital_lock_micro_usd",
            "expected_loss_micro_usd",
            "joan_protocol_micro_usd"
          ],
          "properties": {
            "external_fixed_micro_usd": {"$ref": "#/$defs/integerString"},
            "external_variable_micro_usd": {"$ref": "#/$defs/integerString"},
            "fx_slippage_micro_usd": {"$ref": "#/$defs/integerString"},
            "verification_micro_usd": {"$ref": "#/$defs/integerString"},
            "infrastructure_micro_usd": {"$ref": "#/$defs/integerString"},
            "expected_dispute_micro_usd": {"$ref": "#/$defs/integerString"},
            "capital_lock_micro_usd": {"$ref": "#/$defs/integerString"},
            "expected_loss_micro_usd": {"$ref": "#/$defs/integerString"},
            "joan_protocol_micro_usd": {"const": "0"}
          }
        },
        "explicit_subsidy_micro_usd": {"$ref": "#/$defs/integerString"},
        "unsubsidized_total_effective_cost_micro_usd": {"$ref": "#/$defs/integerString"},
        "buyer_cost_after_explicit_subsidy_micro_usd": {"$ref": "#/$defs/integerString"},
        "unsubsidized_cost_per_expected_successful_item_micro_usd": {"$ref": "#/$defs/integerString"},
        "buyer_cost_per_expected_successful_item_micro_usd": {"$ref": "#/$defs/integerString"}
      }
    }
  }
}
