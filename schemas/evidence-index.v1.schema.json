{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/evidence-index.v1.schema.json",
  "title": "JOAN Evidence Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "generated_at",
    "source",
    "inventory",
    "conformance",
    "supply_chain",
    "verification",
    "benchmark",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "joan.evidence-index.v1"},
    "version": {"const": "0.1.0-alpha.1"},
    "status": {
      "enum": [
        "pending-local-verification",
        "local-verification-passed",
        "local-verification-failed"
      ]
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_digest", "file_count", "excludes"],
      "properties": {
        "tree_digest": {"$ref": "#/$defs/sourceDigest"},
        "file_count": {"type": "integer", "minimum": 1},
        "excludes": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_crates", "json_schemas", "rust_tests"],
      "properties": {
        "workspace_crates": {"type": "integer", "minimum": 1},
        "json_schemas": {"type": "integer", "minimum": 1},
        "rust_tests": {"type": "integer", "minimum": 1}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jce1"],
      "properties": {
        "jce1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "total", "passed", "suite_digest", "implementations"],
          "properties": {
            "status": {"const": "passed-local-cross-implementation"},
            "total": {"const": 27},
            "passed": {"const": 27},
            "suite_digest": {"$ref": "#/$defs/jce1Digest"},
            "implementations": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_audit", "cargo_deny"],
      "properties": {
        "cargo_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "advisory_database_commit", "dependency_count", "vulnerabilities_found"],
          "properties": {
            "status": {"enum": ["passed", "failed", "unexecuted"]},
            "tool_version": {"type": ["string", "null"]},
            "advisory_database_commit": {
              "type": ["string", "null"],
              "pattern": "^[0-9a-f]{40}$"
            },
            "dependency_count": {"type": ["integer", "null"], "minimum": 0},
            "vulnerabilities_found": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "cargo_deny": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "checks"],
          "properties": {
            "status": {"enum": ["passed", "failed", "unexecuted"]},
            "tool_version": {"type": ["string", "null"]},
            "checks": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["advisories", "bans", "licenses", "sources"]}
            }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "command": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed", "unexecuted"]}
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "status", "faster_observed", "language_superiority_claim", "payment_cost"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"const": "equivalent-output"},
        "faster_observed": {"type": "string", "minLength": 1},
        "language_superiority_claim": {"const": false},
        "payment_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "file_sha256", "status", "selected_candidate_id", "universal_cheapest_claim"],
          "properties": {
            "path": {"const": "vectors/payment-cost/report-v0.json"},
            "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "status": {"enum": ["illustrative-local-only", "scenario-local-qualified-quotes-only"]},
            "selected_candidate_id": {"type": "string", "minLength": 1},
            "universal_cheapest_claim": {"const": false}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sourceDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "profile", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "profile": {"const": "joan-source-tree-v1"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "jce1Digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "profile", "domain", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "profile": {"const": "joan-hash-v1"},
        "domain": {"const": "joan.conformance-vector.v1"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
