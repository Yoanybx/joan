{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/verification-gates.v1.schema.json",
  "title": "JOAN Verification Gates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "gates"],
  "properties": {
    "schema": {"const": "joan.verification-gates.v1"},
    "gates": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
