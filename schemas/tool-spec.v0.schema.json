{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/tool-spec.v0.schema.json",
  "title": "JOAN ToolSpec v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "tenant", "purpose", "instruction_budget", "operation", "tests"],
  "properties": {
    "schema": {"const": "joan.tool-spec.v0"},
    "name": {"$ref": "#/$defs/identifier"},
    "tenant": {"$ref": "#/$defs/identifier"},
    "purpose": {"$ref": "#/$defs/identifier"},
    "instruction_budget": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "operation": {"enum": ["identity-i64", "add-i64", "subtract-i64", "multiply-i64", "equal-i64", "and-bool"]},
    "tests": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/test"}}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "identity-i64"}}}, "then": {"properties": {"tests": {"items": {"properties": {"arguments": {"minItems": 1, "maxItems": 1, "prefixItems": [{"$ref": "#/$defs/i64Value"}], "items": false}, "expected": {"$ref": "#/$defs/i64Value"}}}}}}},
    {"if": {"properties": {"operation": {"enum": ["add-i64", "subtract-i64", "multiply-i64"]}}}, "then": {"properties": {"tests": {"items": {"properties": {"arguments": {"minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/i64Value"}, {"$ref": "#/$defs/i64Value"}], "items": false}, "expected": {"$ref": "#/$defs/i64Value"}}}}}}},
    {"if": {"properties": {"operation": {"const": "equal-i64"}}}, "then": {"properties": {"tests": {"items": {"properties": {"arguments": {"minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/i64Value"}, {"$ref": "#/$defs/i64Value"}], "items": false}, "expected": {"$ref": "#/$defs/boolValue"}}}}}}},
    {"if": {"properties": {"operation": {"const": "and-bool"}}}, "then": {"properties": {"tests": {"items": {"properties": {"arguments": {"minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/boolValue"}, {"$ref": "#/$defs/boolValue"}], "items": false}, "expected": {"$ref": "#/$defs/boolValue"}}}}}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$", "not": {"enum": ["fn", "module", "return", "true", "false", "effects"]}},
    "i64Value": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "i64"}, "value": {"type": "string", "minLength": 1, "maxLength": 20, "pattern": "^-?(0|[1-9][0-9]{0,18})$"}}},
    "boolValue": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}},
    "value": {
      "oneOf": [
        {"$ref": "#/$defs/i64Value"},
        {"$ref": "#/$defs/boolValue"}
      ]
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "arguments", "expected"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "arguments": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/value"}},
        "expected": {"$ref": "#/$defs/value"}
      }
    }
  }
}
