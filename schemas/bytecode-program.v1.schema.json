{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/bytecode-program.v1.schema.json",
  "title": "JOAN Verified Bytecode Program v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "module", "semantic_digest", "semantic_identity", "canonical_ast", "entry_function", "functions"],
  "properties": {
    "schema": {"const": "joan.bytecode-program.v1"},
    "module": {"$ref": "#/$defs/identifier"},
    "semantic_digest": {"$ref": "#/$defs/semanticDigest"},
    "semantic_identity": {"$ref": "canonical-ast-identity.v0.schema.json"},
    "canonical_ast": {"$ref": "canonical-ast.v0.schema.json"},
    "entry_function": {"type": "integer", "minimum": 0, "maximum": 1023},
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/function"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "type": {"enum": ["i64", "bool", "string", "unit"]},
    "nonUnitType": {"enum": ["i64", "bool", "string"]},
    "semanticDigest": {
      "allOf": [
        {"$ref": "digest.v1.schema.json"},
        {"type": "object", "properties": {"domain": {"const": "joan.language-canonical-ast.v1"}}}
      ]
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameter_count", "parameter_types", "local_count", "local_types", "return_type", "effects", "instructions"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "parameter_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "parameter_types": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/nonUnitType"}},
        "local_count": {"type": "integer", "minimum": 0, "maximum": 100064},
        "local_types": {"type": "array", "maxItems": 100064, "items": {"$ref": "#/$defs/nonUnitType"}},
        "return_type": {"$ref": "#/$defs/type"},
        "effects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "instructions": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/instruction"}}
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {"type": {"const": "i64"}, "value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {"type": {"const": "string"}, "value": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "unit"}}
        }
      ]
    },
    "instruction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {"op": {"const": "push"}, "value": {"$ref": "#/$defs/value"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "slot"],
          "properties": {"op": {"enum": ["load-local", "store-local"]}, "slot": {"type": "integer", "minimum": 0, "maximum": 100063}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op"],
          "properties": {"op": {"enum": ["pop", "negate", "not", "add", "subtract", "multiply", "divide", "remainder", "equal", "not-equal", "less", "less-equal", "greater", "greater-equal", "and", "or", "return"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "function", "argument_count"],
          "properties": {
            "op": {"const": "call"},
            "function": {"type": "integer", "minimum": 0, "maximum": 1023},
            "argument_count": {"type": "integer", "minimum": 0, "maximum": 64}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "effect", "argument_count"],
          "properties": {
            "op": {"const": "request"},
            "effect": {"$ref": "#/$defs/identifier"},
            "argument_count": {"type": "integer", "minimum": 0, "maximum": 200000}
          }
        }
      ]
    }
  }
}
