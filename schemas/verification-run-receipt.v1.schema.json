{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/verification-run-receipt.v1.schema.json",
  "title": "JOAN Verification Run Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "run_id",
    "status",
    "started_at",
    "completed_at",
    "source",
    "environment",
    "gates",
    "summary",
    "observations",
    "supply_chain"
  ],
  "properties": {
    "schema": {"const": "joan.verification-run-receipt.v1"},
    "version": {"const": "0.1.0-alpha.1"},
    "run_id": {"type": "string", "format": "uuid"},
    "status": {"enum": ["passed", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/source"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "arch", "os_release", "tools", "runner_sha256"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "os_release": {"type": "string", "minLength": 1},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "tools": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/tool"}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/gate"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "executed", "passed", "failed"],
      "properties": {
        "required": {"const": 10},
        "executed": {"type": "integer", "minimum": 1, "maximum": 10},
        "passed": {"type": "integer", "minimum": 0, "maximum": 10},
        "failed": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "observations": {"type": "object"},
    "supply_chain": {"$ref": "#/$defs/supplyChain"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_digest", "file_count", "excludes"],
      "properties": {
        "tree_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "profile", "value"],
          "properties": {
            "algorithm": {"const": "sha256"},
            "profile": {"enum": ["joan-source-tree-v1", "joan-source-tree-v2"]},
            "value": {"$ref": "#/$defs/sha256"}
          }
        },
        "file_count": {"type": "integer", "minimum": 1},
        "excludes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "executable_path",
        "executable_sha256",
        "started_at",
        "completed_at",
        "duration_ms",
        "status",
        "exit_code",
        "signal",
        "stdout",
        "stderr"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "status": {"enum": ["passed", "failed"]},
        "exit_code": {"type": ["integer", "null"]},
        "signal": {"type": ["string", "null"]},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {"$ref": "#/$defs/stream"}
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_audit", "cargo_deny"],
      "properties": {
        "cargo_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "advisory_database_commit", "dependency_count", "vulnerabilities_found"],
          "properties": {
            "status": {"const": "passed"},
            "tool_version": {"type": "string", "minLength": 1},
            "advisory_database_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dependency_count": {"type": "integer", "minimum": 0},
            "vulnerabilities_found": {"const": 0}
          }
        },
        "cargo_deny": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "tool_version", "checks"],
          "properties": {
            "status": {"const": "passed"},
            "tool_version": {"type": "string", "minLength": 1},
            "checks": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {"enum": ["advisories", "bans", "licenses", "sources"]}
            }
          }
        }
      }
    }
  }
}
