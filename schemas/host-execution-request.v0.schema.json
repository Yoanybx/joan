{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/host-execution-request.v0.schema.json",
  "title": "JOAN Host Execution Request v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["bytecode_digest", "operation", "request_digest", "schema", "semantic_digest"],
  "properties": {
    "schema": {"const": "joan.host-execution-request.v0"},
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "compile"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["arguments", "function", "instruction_budget", "kind"],
          "properties": {
            "kind": {"const": "run"},
            "function": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x20-\\x7e]+$"},
            "arguments": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/value"}},
            "instruction_budget": {"type": "integer", "minimum": 1, "maximum": 1000000000}
          }
        }
      ]
    },
    "semantic_digest": {"$ref": "digest.v1.schema.json"},
    "bytecode_digest": {"$ref": "digest.v1.schema.json"},
    "request_digest": {
      "allOf": [
        {"$ref": "digest.v1.schema.json"},
        {"properties": {"domain": {"const": "joan.host-execution-request.v1"}}}
      ]
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {"type": {"const": "i64"}, "value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {"type": {"const": "bool"}, "value": {"type": "boolean"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {"type": {"const": "string"}, "value": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "unit"}}
        }
      ]
    }
  }
}
