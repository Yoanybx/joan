{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joan.invalid/schemas/digest.v1.schema.json",
  "title": "JOAN Typed Digest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "profile",
    "domain",
    "value"
  ],
  "properties": {
    "algorithm": {
      "const": "sha256"
    },
    "profile": {
      "const": "joan-hash-v1"
    },
    "domain": {
      "enum": [
        "joan.canonical-set-element.v1",
        "joan.language-canonical-ast.v1",
        "joan.language-canonical-ast.v2",
        "joan.language-canonical-ast.v3",
        "joan.conformance-vector.v1",
        "joan.source.v1",
        "joan.package-manifest.v1",
        "joan.bytecode-program.v1",
        "joan.bytecode-program.v2",
        "joan.bytecode-program.v3",
        "joan.dispute-case.v1",
        "joan.dispute-claim.v1",
        "joan.resolution-profile.v1",
        "joan.evidence-graph.v1",
        "joan.machine-finding.v1",
        "joan.decision-authorization-proof.v1",
        "joan.effect-application.v1",
        "joan.mock-ledger.v1",
        "joan.benchmark-manifest.v1",
        "joan.native-artifact.v1",
        "joan.native-code.v1",
        "joan.host-execution-request.v1",
        "joan.host-execution-request.v2",
        "joan.host-executor-response.v1",
        "joan.host-executor-response.v2",
        "joan.host-execution-receipt.v1",
        "joan.host-execution-receipt.v2",
        "joan.pr-candidate.v1",
        "joan.pr-trust-policy.v1",
        "joan.pr-trust-evidence.v1",
        "joan.pr-trust-envelope.v1",
        "joan.tool-spec.v1",
        "joan.tool-spec-verification.v1",
        "joan.tool-bundle.v1",
        "joan.tool-verification.v1",
        "joan.tool-finalization.v1",
        "joan.tool-promotion.v1"
      ]
    },
    "value": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
